# ---- 复制本文件为 .env 并填入你自己的值。.env 不要提交到 git，不要暴露给前端 ----

# 你的 Kimi / Moonshot API Key（sk- 开头）。只放服务器端！
MOONSHOT_API_KEY=sk-在这里填你新申请的key

# 国内用 .cn，海外用 .ai
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 模型名：部署前到 Kimi 控制台核对当前可用模型
MOONSHOT_MODEL=moonshot-v1-32k

# 服务监听端口（nginx 反代到这里）
PORT=8788

# 会话签名密钥（生产环境务必改为随机长字符串；HTTPS 下 cookie 自动 secure）
SESSION_SECRET=请替换为随机字符串-at-least-32-chars

# 设为 0 可关闭 Kimi 内置联网搜索（$web_search）；默认开启
# 需 Moonshot 账户支持 builtin_function.$web_search
MOONSHOT_WEB_SEARCH=1

# 单用户每小时最多触发联网搜索的次数（每次 $web_search 约 ¥0.03）
MOONSHOT_SEARCH_HOURLY_MAX=10

# $web_search 工具循环最大轮次（防死循环，默认 3）
MOONSHOT_SEARCH_MAX_ROUNDS=3

# Kimi 请求超时（毫秒）
MOONSHOT_TIMEOUT_MS=120000

# 生产部署时设置（启用 secure cookie 等）
# NODE_ENV=production
